										  return;
										}

										// Generar PDF
										const url = FORM_URL + 'cons/uro/generar_receta_pdf.php?' + $.param({
										  receta: receta,
										  paciente: paciente,
										  fecha: fecha,
										  tratamiento: tratamiento
										});

										window.open(url, '_blank');
									  });
									});
